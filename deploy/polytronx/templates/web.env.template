# Dashboard runtime settings: the web service's env_file.
#
# Copy to POLYTRONX_SECRETS_DIR/web.env (mode 0600). The browser-facing URLs
# (NEXT_PUBLIC_WS_URL and the sandbox provider) are build arguments of the web
# image, not runtime settings: see packages/web/Dockerfile and pins.env.
# CONTROL_PLANE_URL is set by compose.production.yml.

# Must equal SERVICE_AUTH_SECRET_WEB in control-plane.env. preflight compares
# their hashes and never prints either value.
SERVICE_AUTH_SECRET=REPLACE_WITH_HEX_32_BYTES

# The web reads SANDBOX_PROVIDER at runtime on the server. It must match the
# NEXT_PUBLIC_SANDBOX_PROVIDER build argument, which packages/web/Dockerfile defaults to
# modal, so the web image for this deployment must be built with NEXT_PUBLIC_SANDBOX_PROVIDER=vps.
SANDBOX_PROVIDER=vps
LOG_LEVEL=info
