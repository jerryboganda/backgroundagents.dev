# Control-plane settings for the live project: the app service's env_file.
#
# Copy to POLYTRONX_SECRETS_DIR/control-plane.env (mode 0600) on the VPS. Never
# commit a filled-in copy. Every REPLACE_* value must be replaced before preflight
# passes. Generate each secret on the VPS, once, and never regenerate an
# encryption key: a new key cannot read records written with the old one.
#
#   openssl rand -base64 32   # encryption keys and the pepper
#   openssl rand -hex 32      # service and browser secrets (BROWSER_AUTH_SECRET needs 32+ characters)
#
# The variable schema is the Node host's own list (packages/control-plane/src/node/config.ts),
# cross-checked by its env-example test. Required at boot: DEPLOYMENT_NAME,
# GITHUB_BOT_USERNAME, TOKEN_ENCRYPTION_KEY, PROVIDER_ACCOUNTS_ENCRYPTION_KEY,
# REPO_SECRETS_ENCRYPTION_KEY, and DATA_DIR (set by compose).
# runbooks/accounts-and-admission.md says where each value comes from.

# ---- Identity and URLs (not secret, per deployment) ----
DEPLOYMENT_NAME=polytronx-openinspect
APP_NAME=PolytronX OpenInspect
WEB_APP_URL=https://ai.polytronx.com
WORKER_URL=https://cp.ai.polytronx.com
SCM_PROVIDER=github
LOG_LEVEL=info

# ---- GitHub App (dedicated, installed on pilot repositories only) ----
GITHUB_BOT_USERNAME=REPLACE_WITH_APP_BOT_LOGIN
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_APP_INSTALLATION_ID=REPLACE_WITH_INSTALLATION_ID
# PEM on one line. Write each newline as the two characters \n.
GITHUB_APP_PRIVATE_KEY=REPLACE_WITH_PEM_ON_ONE_LINE

# ---- GitHub OAuth (sign-in; the callback is WEB_APP_URL/api/auth/callback/github) ----
GITHUB_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET

# ---- Admission: fail closed. At least one allowlist must name the pilot users. ----
UNSAFE_ALLOW_ALL_USERS=false
ALLOWED_USERS=jerryboganda
ALLOWED_GITHUB_ORGS=
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
TEAMS_ENFORCEMENT=on

# ---- Sandbox provider: the VPS executor. No Modal account is needed. ----
# The executor's private edge, over https. The two secrets are shared with executor.env
# on the executor host: the same value on both sides.
SANDBOX_PROVIDER=vps
VPS_EXECUTOR_URL=https://172.235.26.148:19443
VPS_EXECUTOR_TOKEN=REPLACE_WITH_HEX_32_BYTES
VPS_EXECUTOR_ADMISSION_SECRET=REPLACE_WITH_HEX_32_BYTES
# Boot and execution limits. Upstream defaults apply when these are unset.
# SANDBOX_BOOT_TIMEOUT_MS=1800000
# EXECUTION_TIMEOUT_MS=5400000
# SANDBOX_INACTIVITY_TIMEOUT_MS=

# ---- Encryption keys (generate once; never regenerate in place) ----
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
PROVIDER_ACCOUNTS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
REPO_SECRETS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
IMAGE_CALLBACK_TOKEN_PEPPER=REPLACE_WITH_BASE64_32_BYTES

# ---- Browser sign-in secret (at least 32 characters) ----
BROWSER_AUTH_SECRET=REPLACE_WITH_HEX_32_BYTES

# ---- Service-to-service auth: the web's secret. Must equal web.env SERVICE_AUTH_SECRET. ----
SERVICE_AUTH_SECRET_WEB=REPLACE_WITH_HEX_32_BYTES
# Leave these empty. This deployment runs no Slack, GitHub-bot or Linear bot service.
SERVICE_AUTH_SECRET_SLACK_BOT=
SERVICE_AUTH_SECRET_GITHUB_BOT=
SERVICE_AUTH_SECRET_LINEAR_BOT=

# ---- Optional: Google sign-in (needs its own callback) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: API-key modes. Anthropic on OpenCode always needs this key. ----
ANTHROPIC_API_KEY=
