# Non-secret release state for compose.production.yml and every script here.
#
# Copy to /opt/polytronx/openinspect/state/release.env on the VPS, once per
# release, and fill in the values from the CI release manifest
# (runbooks/deploy-and-rollback.md). Nothing in this file is a secret.
#
# A value still named REPLACE_* or CHANGEME fails preflight and the deploy.
# That is deliberate: the stack refuses to start on placeholders.

# Upstream commit this release is built from. Must equal UPSTREAM_REVISION in pins.env.
OPEN_INSPECT_REVISION=REPLACE_WITH_40_HEX_UPSTREAM_COMMIT
# Deployment overlay commit (this repository) that produced the images.
OVERLAY_REVISION=REPLACE_WITH_40_HEX_OVERLAY_COMMIT
# Highest migration version in terraform/d1/migrations at this revision, four digits.
MIGRATIONS_LATEST=REPLACE_WITH_NNNN

# Image references and the immutable IDs they must resolve to. The ID is the
# sha256 image ID from the CI manifest. The reference is the tag that docker load
# restores, or a registry reference pinned by digest once publication is authorized.
CONTROL_PLANE_IMAGE=REPLACE_WITH_IMAGE_REFERENCE
CONTROL_PLANE_IMAGE_ID=sha256:REPLACE_WITH_64_HEX
WEB_IMAGE=REPLACE_WITH_IMAGE_REFERENCE
WEB_IMAGE_ID=sha256:REPLACE_WITH_64_HEX
DOCS_IMAGE=REPLACE_WITH_IMAGE_REFERENCE
DOCS_IMAGE_ID=sha256:REPLACE_WITH_64_HEX

# Host paths. Secrets never live under the source tree.
POLYTRONX_SECRETS_DIR=/opt/polytronx/openinspect/secrets
POLYTRONX_SOURCE_DIR=/opt/polytronx/openinspect/source
# Public CA certificate of the executor's private edge: a copy of /etc/polytronx/edge-ca/ca.crt from the
# executor host, mode 0644, outside the secrets directory. Never ca.key. preflight.sh refuses a file the
# container user cannot read.
POLYTRONX_EXECUTOR_CA_FILE=/opt/polytronx/openinspect/trust/executor-edge-ca.crt

# Network and ports. The edge network is shared only with the existing proxy.
POLYTRONX_EDGE_NETWORK=polytronx-edge
CONTROL_PLANE_LOOPBACK_PORT=18787
WEB_LOOPBACK_PORT=13080
DOCS_LOOPBACK_PORT=13081

# Object-store buckets: media, and the Litestream replica of global.db.
OBJECT_STORE_BUCKET=openinspect-media
LITESTREAM_BUCKET=openinspect-backups

# Optional resource overrides. Defaults are in compose.production.yml.
# CONTROL_PLANE_MEM_LIMIT=1536m
# CONTROL_PLANE_CPUS=2
# WEB_MEM_LIMIT=768m
# WEB_CPUS=1
# DOCS_MEM_LIMIT=512m
# DOCS_CPUS=1
