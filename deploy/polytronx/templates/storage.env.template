# Object-store and Litestream credentials: env_file for app, object-store and litestream.
#
# Copy to POLYTRONX_SECRETS_DIR/storage.env (mode 0600). SeaweedFS takes these
# as its root identity, and the control plane and Litestream use the same pair
# as S3 credentials. The bucket names are in release.env, not here.
#
#   openssl rand -hex 32
#
# The encrypted backup includes this file. The backup key must be kept off the
# host, in a password manager or on an offline medium: without it no backup can
# be read, so the restore procedure has nothing to work from.

AWS_ACCESS_KEY_ID=objectstoreadmin
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_HEX_32_BYTES
LITESTREAM_ACCESS_KEY_ID=objectstoreadmin
LITESTREAM_SECRET_ACCESS_KEY=REPLACE_WITH_HEX_32_BYTES
