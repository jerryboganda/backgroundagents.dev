#!/usr/bin/env bash
# Test stub for docker. Records every call in $STUB_LOG and answers from environment
# variables. It never reaches a daemon, a registry or a network.
printf 'docker %s\n' "$*" >>"$STUB_LOG"
case "$1" in
  version) echo 27.0.0 ;;
  info) echo "${STUB_DOCKER_ROOT-/var/lib/docker}" ;;
  ps) printf '%s' "${STUB_RUNNING:-}" ;;
  network) exit 0 ;;
  image)
    # A present image answers inspect. Asked for RepoDigests, it reports the digest of the reference
    # it was given, as if pulled by that digest. STUB_REPO_DIGEST overrides that.
    if [ "$2" = inspect ] && [ -n "${STUB_IMAGE_MISSING:-}" ]; then exit 1; fi
    case "$*" in
      *RepoDigests*) printf '%s\n' "${STUB_REPO_DIGEST-${!#}}" ;;
      *) echo "${STUB_IMAGE_ID:-sha256:$(printf 'a%.0s' {1..64})}" ;;
    esac
    ;;
  volume)
    case "$2" in
      ls) printf '%s' "${STUB_VOLUMES:-}" ;;
      inspect) exit "${STUB_VOLUME_EXIT:-1}" ;;
    esac
    ;;
  run)
    # The archive helper streams the fixture tree as a tar on stdout. The restore helper streams
    # an archive on stdin, which this stub reads and drops.
    cat >/dev/null
    if [ -n "${STUB_ARCHIVE_SRC:-}" ]; then tar -C "$STUB_ARCHIVE_SRC" -cf - .; fi
    exit "${STUB_RUN_EXIT:-0}"
    ;;
  compose)
    sub=""
    for arg in "$@"; do
      case "$arg" in
        up | stop | config | create | down | logs | ps) sub="$arg"; break ;;
      esac
    done
    case "$sub" in
      up) exit "${STUB_UP_EXIT:-0}" ;;
      stop) exit "${STUB_STOP_EXIT:-0}" ;;
      ps) printf '%s' "${STUB_COMPOSE_PS_OUTPUT:-}"; exit "${STUB_COMPOSE_PS_EXIT:-0}" ;;
      logs) printf '%s' "${STUB_COMPOSE_LOGS_OUTPUT:-}"; exit "${STUB_COMPOSE_LOGS_EXIT:-0}" ;;
      create)
        # Compose reads each service's env_file while it creates the services, so a missing one
        # stops create. STUB_COMPOSE_ENV_CHECK turns that on; the names are the production env files.
        if [ -n "${STUB_COMPOSE_ENV_CHECK:-}" ]; then
          for file in control-plane.env storage.env web.env; do
            [ -f "$POLYTRONX_SECRETS_DIR/$file" ] || {
              echo "env file $POLYTRONX_SECRETS_DIR/$file not found" >&2
              exit 1
            }
          done
        fi
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;
  *) exit 0 ;;
esac
