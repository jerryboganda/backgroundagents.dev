# Non-secret pins for the PolytronX deployment. Changing a value here is a release
# decision: CI and preflight both read this file, and the release manifest records it.
#
# UPSTREAM_REVISION is the reviewed commit of ColeMurray/background-agents. The
# image and workflow checks refuse any upstream file that differs from it.
UPSTREAM_REPOSITORY=https://github.com/ColeMurray/background-agents
UPSTREAM_REVISION=02a6bbf1c2720699444d91867026e8b0111ed6fc

# Sandbox cap this deployment expects from the Modal provider: parent plus child, so 2.
# The provider's MAX_ACTIVE_SANDBOXES is set in its dedicated Modal environment. preflight.sh
# refuses to deploy unless the provider reports this value with capacity_enforcement pre-create.
PROVIDER_MAX_ACTIVE_SANDBOXES=2

# Browser-facing control-plane URL, inlined into the web bundle at build time
# (packages/web/src/hooks/use-session-transport.ts). A change needs a web image rebuild.
PUBLIC_WS_URL=wss://cp.ai.polytronx.com

# Base images by manifest-list digest, resolved from the registry on 2026-10-16.
# The upstream control-plane Dockerfile still names node:24-slim by tag; the
# CI-recorded image ID is what the deployment pins (see runbooks/deploy-and-rollback.md).
NODE_IMAGE=node:24-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5
LITESTREAM_IMAGE=litestream/litestream:0.3.13@sha256:027eda2a89a86015b9797d2129d4dd447e8953097b4190e1d5a30b73e76d8d58
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.47@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882
